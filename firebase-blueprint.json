{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information isolated to the authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "User email address.",
          "minLength": 3,
          "maxLength": 100
        },
        "displayName": {
          "type": "string",
          "description": "Display name of user.",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL of user.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A personal to-do item strictly isolated to the owning user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the task.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Task title or summary.",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "Detailed notes or description for the task.",
          "maxLength": 2000
        },
        "completed": {
          "type": "boolean",
          "description": "Completion state of the task."
        },
        "priority": {
          "type": "string",
          "description": "Urgency/importance tier.",
          "enum": ["low", "medium", "high", "urgent"]
        },
        "category": {
          "type": "string",
          "description": "Categorization tag for the task.",
          "enum": ["work", "personal", "shopping", "health", "finance", "general"]
        },
        "dueDate": {
          "type": "string",
          "description": "Optional due date formatted as YYYY-MM-DD or empty.",
          "maxLength": 50
        },
        "userId": {
          "type": "string",
          "description": "UID of the owner who created and owns this task.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["id", "title", "completed", "priority", "category", "userId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection isolated to the authenticated user."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Personal task subcollection isolated exclusively to the owner."
    }
  }
}
